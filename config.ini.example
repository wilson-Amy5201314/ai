; 可选：把本文件复制为 config.ini 即可覆盖内置连接配置。
; 不创建 config.ini 时使用 公共\AppConfig.cpp 里的默认值，程序照常运行。
; config.ini 只放在本地，不要随源码提交。

[ai]
; 接口地址
base_url=https://api.deepseek.com/chat/completions
; 留空或保持注释 = 沿用源码内置默认值；只有确实要换用别的密钥时才取消注释
;api_key=
model=deepseek-chat

[storage]
; 相对路径按项目根目录解析
sqlite_file=data/xinyu.db
